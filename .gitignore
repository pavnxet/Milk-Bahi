+++ .gitignore (修改后)
```
# Android build artifacts
*.apk
*.aab
build/
.gradle/
local.properties

# Java/Android compiled files
*.class
*.jar
*.war
*.ear

# Dependencies
node_modules/
.libs/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# System files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz

{
  "name": "milk-tracker",
  "version": "2.0.0",
  "description": "Daily milk tracking app for Mom.",
  "scripts": {
    "start": "npx cap serve",
    "build": "esbuild src/app.js --bundle --outfile=www/js/app.js --format=esm && npx cap sync",
    "android": "npx cap open android",
    "generate-assets": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/local-notifications": "^5.0.8",
    "@capacitor/share": "^5.0.8",
    "@capacitor/toast": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^5.0.0",
    "esbuild": "^0.27.3"
  }
}

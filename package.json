{
  "name": "milk-bahi",
  "version": "3.1.0",
  "description": "Daily milk tracking app for Mom.",
  "scripts": {
    "start": "npx cap serve",
    "build": "esbuild src/app.js --bundle --minify --outfile=www/js/app.js --format=esm && npx cap sync",
    "build:debug": "esbuild src/app.js --bundle --outfile=www/js/app.js --format=esm && npx cap sync",
    "android": "npx cap open android",
    "generate-assets": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/toast": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capawesome/capacitor-libsql": "^0.2.2",
    "chart.js": "^4.5.1",
    "jspdf": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.27.3"
  }
}
